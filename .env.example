# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

# Safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never expose this in client code or commit it. It bypasses
# Row Level Security, so it's used only in trusted server-side admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER-ONLY. Powers the "your order is confirmed" email sent after every
# checkout. This is the same Resend API key already used for the Supabase
# SMTP setup (login codes) — find it again at resend.com under API Keys, or
# reuse the one you already created.
RESEND_API_KEY=your-resend-api-key
