# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

# Safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never expose this in client code or commit it. It bypasses
# Row Level Security, so it's used only in trusted server-side admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER-ONLY. Powers the "your order is confirmed" email sent after every
# checkout. This is the same Resend API key already used for the Supabase
# SMTP setup (login codes) — find it again at resend.com under API Keys, or
# reuse the one you already created.
RESEND_API_KEY=your-resend-api-key

# SERVER-ONLY. Whop payment integration (temporary processor). Get the API
# key from your Whop dashboard's Developer > API Keys page (scopes: create +
# read checkout configurations, create + read checkout requests, read
# payments, read changes to payments). The webhook secret comes from setting
# up a webhook endpoint pointing at https://yourdomain.com/api/webhooks/whop
# in the Whop dashboard — it's shown once when you create that webhook.
WHOP_API_KEY=your-whop-api-key
WHOP_WEBHOOK_SECRET=your-whop-webhook-secret
